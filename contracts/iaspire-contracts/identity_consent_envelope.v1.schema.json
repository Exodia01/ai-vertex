{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "iaspire-contracts/identity_consent_envelope/v1",
  "title": "Identity / Consent Envelope",
  "description": "Anchors 1-2 only (Master §3.5). Carries consent scope and purpose-limitation tags on every record crossing a boundary.",
  "type": "object",
  "required": ["customer_ref", "consent_scope", "purpose", "granted_at"],
  "additionalProperties": false,
  "properties": {
    "customer_ref": { "type": "string", "pattern": "^cust_[a-z0-9_]{4,32}$" },
    "consent_scope": {
      "description": "Per-field scope, enforced per data field and not merely per customer (Anchor 1 §13).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["txn.read", "bal.read", "profile.read", "goal.write", "goal.read", "aggregate.export"]
      }
    },
    "purpose": {
      "type": "string",
      "enum": ["journal_analysis", "segment_aggregation", "policy_design", "council_deliberation"]
    },
    "granted_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "withdrawn_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
