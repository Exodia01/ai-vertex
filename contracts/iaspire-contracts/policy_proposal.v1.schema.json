{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "iaspire-contracts/policy_proposal/v1",
  "title": "POLICY_PROPOSAL v1",
  "description": "Anchor 3 -> Anchor 4 (Anchor 3 §10). Structured object, never free-text-only. Evidence references point at CUSTOMER_SEGMENT_INSIGHT records, never Anchor 1 data.",
  "type": "object",
  "required": [
    "policy_id",
    "version",
    "lifecycle_state",
    "target_segment",
    "customer_need",
    "evidence",
    "financial_mechanism",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": true,
  "properties": {
    "policy_id": { "type": "string", "pattern": "^pol_[a-z0-9_]{4,32}$" },
    "version": { "type": "string", "pattern": "^v[0-9]+(\\.[0-9]+)?$" },
    "lifecycle_state": {
      "type": "string",
      "enum": ["DRAFT", "SIMULATION", "PENDING_COUNCIL", "APPROVED", "ACTIVE", "MONITORED", "MODIFIED", "RETIRED", "REJECTED"]
    },
    "target_segment": { "type": "string", "minLength": 1, "maxLength": 64 },
    "customer_need": {
      "type": "string",
      "enum": ["travel", "asset", "protection", "liquidity", "wealth", "debt"]
    },
    "evidence": {
      "description": "CUSTOMER_SEGMENT_INSIGHT references only. Must never contain Anchor 1 identifiers.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^csi_[a-z0-9_]{4,32}$" }
    },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "eligibility": { "type": "object" },
    "financial_mechanism": { "type": "string", "minLength": 1 },
    "expected_customer_benefit": { "type": "string" },
    "institution_benefit": { "type": "string" },
    "risk": { "type": "array", "items": { "type": "string" } },
    "compliance_considerations": { "type": "array", "items": { "type": "string" } },
    "operational_requirements": { "type": "array", "items": { "type": "string" } },
    "servicing_requirements": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "estimated_scale": { "type": ["integer", "null"], "minimum": 0 },
    "conflicts_tradeoffs": { "type": "array", "items": { "type": "object" } },
    "retirement_conditions": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
